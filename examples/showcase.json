{
  "title": "Lumen3D Showcase",
  "description": "A gallery of primitives, materials, lights and animations — all from one JSON file.",
  "scene": {
    "background": { "type": "gradient", "top": "#241a45", "bottom": "#04050c" },
    "fog": { "color": "#04050c", "near": 16, "far": 70 },
    "shadows": true,
    "environment": true,
    "exposure": 1.05
  },
  "camera": {
    "fov": 48,
    "position": [10, 6, 12],
    "lookAt": [0, 1.2, 0]
  },
  "controls": {
    "autoRotate": true,
    "autoRotateSpeed": 0.4,
    "enablePan": true,
    "minDistance": 6,
    "maxDistance": 30,
    "maxPolarAngle": 1.5
  },
  "lights": [
    { "type": "hemisphere", "skyColor": "#cfe0ff", "groundColor": "#241a45", "intensity": 0.55 },
    { "type": "directional", "color": "#ffffff", "intensity": 2.6, "position": [10, 14, 8], "castShadow": true },
    { "type": "point", "color": "#ff5c9e", "intensity": 60, "position": [-6, 4, -4] },
    { "type": "point", "color": "#4de1c1", "intensity": 60, "position": [6, 3, 4] }
  ],
  "ground": {
    "enabled": true,
    "size": 80,
    "color": "#0a0b1a",
    "grid": { "size": 80, "divisions": 80, "color1": "#39306a", "color2": "#181530" }
  },
  "objects": [
    {
      "id": "knot",
      "type": "torusKnot",
      "radius": 1.3,
      "tube": 0.4,
      "position": [0, 2.2, 0],
      "material": { "type": "physical", "color": "#8a7dff", "metalness": 0.5, "roughness": 0.12, "clearcoat": 1, "emissive": "#241a55", "emissiveIntensity": 0.5 },
      "animation": { "type": "rotate", "axis": "y", "speed": 0.6 }
    },
    {
      "id": "sphere-glass",
      "type": "sphere",
      "radius": 1.0,
      "position": [-4.5, 1.0, -1],
      "material": { "type": "physical", "color": "#ffffff", "metalness": 0, "roughness": 0.02, "transmission": 0.9, "transparent": true, "opacity": 0.9, "ior": 1.4 },
      "animation": { "type": "float", "speed": 1.4, "amplitude": 0.4 }
    },
    {
      "id": "metal-cube",
      "type": "box",
      "size": [1.4, 1.4, 1.4],
      "position": [4.5, 0.9, -1],
      "material": { "type": "standard", "color": "#c9ccd6", "metalness": 1.0, "roughness": 0.18 },
      "animation": { "type": "spin", "axis": "x", "speed": 0.5 }
    },
    {
      "id": "cone",
      "type": "cone",
      "radius": 0.9,
      "height": 1.8,
      "position": [-2.5, 0.9, 3],
      "material": { "type": "standard", "color": "#ff8a5c", "roughness": 0.4, "metalness": 0.1 },
      "animation": { "type": "float", "speed": 1.0, "amplitude": 0.25 }
    },
    {
      "id": "glow-orb",
      "type": "icosahedron",
      "radius": 0.55,
      "detail": 1,
      "position": [3, 1.4, 3],
      "material": { "type": "standard", "color": "#4de1c1", "emissive": "#4de1c1", "emissiveIntensity": 2.5, "roughness": 0.4 },
      "animation": { "type": "orbit", "speed": 0.7, "radius": 3.2, "height": 0.6 }
    },
    {
      "id": "wire-dodeca",
      "type": "dodecahedron",
      "radius": 6.5,
      "position": [0, 3, 0],
      "castShadow": false,
      "material": { "type": "basic", "color": "#39306a", "wireframe": true },
      "animation": { "type": "rotate", "axis": "y", "speed": -0.08 }
    }
  ],
  "effects": {
    "bloom": { "strength": 0.7, "radius": 0.5, "threshold": 0.75 }
  },
  "overlay": {
    "subtitle": "Lumen3D · showcase",
    "title": "One JSON file. A whole 3D world.",
    "description": "Primitives, PBR materials, glass, emissive glow, orbiting bodies, bloom — declared, not coded. Drag to orbit · scroll to zoom · right-drag to pan.",
    "position": "bottom-left",
    "accent": "#8a7dff",
    "links": [
      { "label": "Read the docs", "url": "https://github.com/zackarman28346-sketch/https-github.com-zackarman28346-sketch-claude#readme" },
      { "label": "Star on GitHub", "url": "https://github.com/zackarman28346-sketch/https-github.com-zackarman28346-sketch-claude" }
    ]
  }
}
